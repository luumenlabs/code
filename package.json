{
  "name": "luu-code",
  "version": "0.1.0",
  "private": true,
  "description": "Use Claude Code or Codex with Roblox Studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luumenlabs/code.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@luumen/code-app",
    "site": "turbo run dev --filter=@luumen/code-site",
    "site:build": "turbo run build --filter=@luumen/code-site",
    "serve": "turbo run build --filter=@luumen/code-server && node packages/server/bin/luu-code.js serve",
    "assets:icons": "pnpm --filter @luumen/code-app run icons",
    "plugin:install": "cd plugin && luu install",
    "plugin:build": "cd plugin && luu build",
    "plugin:dev": "cd plugin && luu dev",
    "plugin:check": "cd plugin && luu run check",
    "check": "turbo run build typecheck test && pnpm plugin:check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
