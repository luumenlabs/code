{
  "name": "@luumen/code-server",
  "version": "0.1.0",
  "description": "Local server for Luu Code: Roblox Studio bridge, permissions, and MCP interface.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin/luu-code-mcp.js": "./bin/luu-code-mcp.js"
  },
  "bin": {
    "luu-code": "./bin/luu-code.js",
    "luu-code-mcp": "./bin/luu-code-mcp.js"
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/cli/main.ts serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@luumen/code-protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
